def main():
    ap = argparse.ArgumentParser(prog="proj", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="every project, its port and status").set_defaults(fn=cmd_list)
    sub.add_parser("ports", help="the full port map").set_defaults(fn=cmd_ports)
    sub.add_parser("alloc", help="print the next free port").set_defaults(fn=cmd_alloc)

    p = sub.add_parser("port", help="print a project's port (defaults to the cwd's)")
    p.add_argument("name", nargs="?", help="project name; omit to resolve the cwd")
    p.set_defaults(fn=cmd_port)

    p = sub.add_parser("doctor", help="audit listeners and source against the registry")
    p.add_argument("--no-scan", action="store_true",
                   help="skip the source scan for hardcoded ports")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("add", help="register a project")
    p.add_argument("name")
    p.add_argument("dir", nargs="?", help="its directory (not with --worktree)")
    p.add_argument("--worktree", metavar="REPO",
                   help="make a new worktree of REPO (a project name or a path) for it")
    p.add_argument("--branch", help="worktree branch (default: from --jira, else NAME)")
    p.add_argument("--from", metavar="REF", help="base for a new branch (default: HEAD)")
    p.add_argument("--subdir", help="register this directory inside the worktree")
    p.add_argument("--jira", metavar="KEY", help="link a ticket (and name the branch for it)")
    p.add_argument("--command",
                   help="an existing launch script that names the session (SESSION=...)")
    p.add_argument("--session", help="agent tmux session name (default: the project's)")
    p.add_argument("--launch-script", action="store_true",
                   help="write a launch.sh that runs `proj agent NAME`")
    p.add_argument("--desc", help="one-line description shown on the dashboard")
    p.add_argument("--web-start", help='how to serve it, e.g. "python3 serve.py $PORT"')
    p.add_argument("--port", type=int, help="allocate this specific pool port")
    p.add_argument("--fixed-port", type=int,
                   help="adopt a port the project hardcodes itself")
    p.add_argument("--host", help="only if the service binds one specific IP")
    p.add_argument("--no-web", action="store_true", help="register without a web instance")
    p.add_argument("--no-page", action="store_true",
                   help="skip the scaffolded status page")
    p.add_argument("--create-dir", action="store_true", help="mkdir the directory if absent")
    p.set_defaults(fn=cmd_add)

    p = sub.add_parser("agent", help="start a project's agent session and attach to it")
    p.add_argument("name")
    p.add_argument("agent", nargs="?", help="which agent (default: the first offered)")
    p.add_argument("-r", "--restart", action="store_true", help="kill and restart it first")
    p.add_argument("-d", "--detach", action="store_true", help="start it, don't attach")
    p.set_defaults(fn=cmd_agent)

    p = sub.add_parser("stop", help="kill a project's agent session")
    p.add_argument("name")
    p.add_argument("agent", nargs="?")
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("rm", help="unregister a project")
    p.add_argument("name")
    p.add_argument("--worktree", action="store_true",
                   help="also remove the linked worktree it lives in (the branch is kept)")
    p.add_argument("--force", action="store_true", help="even with uncommitted changes")
    p.set_defaults(fn=cmd_rm)

    sub.add_parser("worktrees", help="every worktree of the repos in use"
                   ).set_defaults(fn=cmd_worktrees)

    p = sub.add_parser("jira", help="tickets: list, show, link, comment, move, new")
    p.set_defaults(fn=cmd_jira, jcmd=None)
    js = p.add_subparsers(dest="jcmd")
    q = js.add_parser("list", help="your tickets (the config's jql)")
    q.add_argument("--jql")
    q = js.add_parser("show", help="one ticket in full")
    q.add_argument("key")
    for verb in ("link", "unlink"):
        q = js.add_parser(verb, help=f"{verb} a ticket and a project")
        q.add_argument("name")
        q.add_argument("key")
    q = js.add_parser("comment", help="comment on a ticket ('-' reads stdin)")
    q.add_argument("key")
    q.add_argument("text")
    q = js.add_parser("move", help="move a ticket to a status (or by transition name)")
    q.add_argument("key")
    q.add_argument("status")
    q = js.add_parser("new", help="open a ticket")
    q.add_argument("summary")
    q.add_argument("--desc")
    q.add_argument("--project", help="project key (default: [jira] default_project)")
    q.add_argument("--type", help="issue type (default: [jira] issue_type)")
    q.add_argument("--link", metavar="NAME", help="link it to a registered project")
    q.add_argument("--unassigned", action="store_true", help="don't assign it to yourself")

    p = sub.add_parser("set", help="edit registry fields")
    p.add_argument("name")
    p.add_argument("assignments", nargs="+", metavar="KEY=VALUE")
    p.set_defaults(fn=cmd_set)

    p = sub.add_parser("up", help="start a web instance")
    p.add_argument("name")
    p.set_defaults(fn=cmd_up)

    p = sub.add_parser("down", help="stop a web instance")
    p.add_argument("name")
    p.set_defaults(fn=cmd_down)

    p = sub.add_parser("url", help="print a project's URL")
    p.add_argument("name")
    p.set_defaults(fn=cmd_url)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
