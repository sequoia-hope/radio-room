#!/usr/bin/env python3
"""proj — register projects and their centrally allocated web ports.

    proj list                     every project, its port and whether it is up
    proj add NAME --worktree REPO [--branch B] [--from REF] [--subdir D] [--jira KEY]
                                  a new worktree of REPO, registered as a project
    proj worktrees                every worktree of the repos in use, registered or not
    proj jira [list|show|link|unlink|comment|move|new]   tickets (see proj jira -h)
    proj agent NAME [AGENT]       start a project's agent session and attach
    proj stop NAME [AGENT]        kill a project's agent session
    proj ports                    the full port map, including squatters
    proj add NAME DIR [options]   register a project; allocates the next free port
    proj rm NAME                  unregister
    proj set NAME KEY=VALUE ...   edit registry fields
    proj up NAME | down NAME      start/stop a web instance in tmux
    proj url NAME                 print its URL
    proj port [NAME]              print its port — with no name, the cwd's
    proj alloc                    print the next free port and exit
    proj doctor                   audit what is listening against the registry

`proj add` is the whole registration story in one command: it appends the
project to the registry (so the desktop window, the voice server and the hub
all see it) and allocates a port from the pool. Nothing else on the machine
needs to learn about the new project: its agent session is named after it, and
`proj agent NAME` starts and attaches to it.

A project that took a port also gets a status page template at index.html, and
the static server to serve it with, so its entry on the hub opens onto
something from the first minute instead of a dead link. A directory that
already answers at its root keeps whatever it has; --no-page skips it.
"""

import argparse
import os
import re
import sys
import time
from datetime import date
from pathlib import Path
from string import Template

import git
import jira
import registry

# A launch script for a project directory, for those who like `./launch.sh`
# (`proj add --launch-script`). It only hands over to `proj agent`, so how a
# session is started stays in the registry.
LAUNCH_TEMPLATE = """#!/usr/bin/env bash
# launch.sh — start (or reattach to) this project's agent session.
#   ./launch.sh [-r] [agent]     -r restarts it; agent defaults to the first offered
set -euo pipefail
PROJ="$(command -v proj || echo "{proj}")"
exec "$PROJ" agent {name} "$@"
"""

